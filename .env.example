# Copy to .env and fill in real values. Never commit .env.

# ---- Database ----
POSTGRES_DB=medidrop
POSTGRES_USER=medidrop
POSTGRES_PASSWORD=change-me-strong-password
MEDIDROP_DB_POOL_SIZE=20

# ---- API security ----
# Required. Generate with: openssl rand -base64 48
MEDIDROP_JWT_SECRET=
MEDIDROP_CORS_ORIGINS=https://app.example.com
MEDIDROP_PUBLIC_URL=https://api.example.com
MEDIDROP_FRONTEND_URL=https://app.example.com
# Keep false in production unless the API schema is intentionally published.
MEDIDROP_OPENAPI_ENABLED=false

# ---- File storage (prescriptions) ----
# local keeps files on the mounted volume; s3 is a recognised provider name but
# the S3 adapter is not implemented yet, so keep it local for now.
MEDIDROP_STORAGE_PROVIDER=local
MEDIDROP_STORAGE_PATH=/app/storage/prescriptions

# ---- Payments ----
# sandbox simulates capture and marks payments is_test=true; it is refused under
# the prod profile unless explicitly allowed by the provider factory.
MEDIDROP_PAYMENTS_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Maps ----
# haversine computes distance only (no geocoding); google needs a server key.
MEDIDROP_MAPS_PROVIDER=haversine
MEDIDROP_MAPS_API_KEY=

# ---- Notifications ----
MEDIDROP_MAIL_PROVIDER=console
MEDIDROP_SMS_PROVIDER=console

# ---- Frontend build (optional) ----
VITE_GOOGLE_MAPS_API_KEY=
