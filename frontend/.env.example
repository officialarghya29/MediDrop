# API base URL (leave blank to use the Vite proxy in local development)
VITE_API_URL=

# WebSocket endpoint used for live order tracking
VITE_WS_URL=ws://localhost:8080/ws

# Browser-restricted Google Maps key. When absent, the tracking map shows a
# coordinate-based fallback and clearly states that live maps are not configured.
VITE_GOOGLE_MAPS_API_KEY=
